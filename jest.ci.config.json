{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s",
    "!**/*.spec.ts",
    "!main.ts"
  ],
  "coverageDirectory": "../coverage",
  "coverageThreshold": {
    "global": {
      "lines": 80,
      "statements": 80,
      "functions": 80,
      "branches": 70
    }
  },
  "testEnvironment": "node",
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "test-results",
        "outputName": "unit-tests.xml",
        "suiteName": "Unitarias e integración"
      }
    ]
  ]
}
